#!/usr/bin/env zsh
# shellcheck disable=SC1071 # intentionally zsh; ShellCheck does not support it
#
# Demo of every macro carapace-spec ships built in (registered automatically just by
# compleo importing carapace-spec). Each flag below exists purely to show one macro's
# completion in action; the script itself just echoes what was parsed.
#
# Try it:
#   mise run build && PATH="$PWD/bin:$PATH" examples/macros --help
#   source <(PATH="$PWD/bin:$PATH" compleo completion) # then Tab-complete after any flag
#
# --file/--file-ext both use the same $files macro - bare, then customized with an
# extension filter - to show a macro being reused differently per flag. Named so they
# sort next to each other in --help, since pflag always lists flags alphabetically.

spec=$(<<'SPEC'
description: Demo of every core carapace-spec macro.
flags:
  --file=: {description: "$files, unfiltered", completion: ["$files"]}
  --file-ext=: {description: "$files, same macro filtered to .go files", completion: ["$files([.go])"]}
  --dir=: {description: "$directories", completion: ["$directories"]}
  --exe=: {description: "$executables", completion: ["$executables"]}
  --note=: {description: "$message - a static hint instead of real completions", completion: ["$message(this flag only shows a hint - type anything)"]}
  --shell-out=: {description: "$zsh - completion values come from running a real shell command", completion: ["$zsh(echo -e 'one\\ntwo\\nthree')"]}
  --chdir=: {description: "$chdir - complete as if run from another directory", completion: ["$files", "$chdir(/tmp)"]}
  --filter=: {description: "$filter - drop specific values from a list", completion: ["one", "two", "three", "$filter([two])"]}
  --filterargs=: {description: "$filterargs - drop values already used elsewhere on the line", completion: ["$files", "$filterargs"]}
  --list=: {description: "$list - split one candidate into several on a separator", completion: ["one", "two", "three", "$list(,)"]}
  --multiparts=: {description: "$multiparts - complete one path segment at a time", completion: ["one/two/three", "$multiparts([/])"]}
  --nospace=: {description: "$nospace - no trailing space after matching values", completion: ["one", "two/", "three,", "$nospace(/,)"]}
  --noprefix=: {description: "$noprefix - hide a literal prefix from what gets inserted", completion: ["--", "---", "one--", "one---", "$noprefix(-)"]}
  --prefix=: {description: "$prefix - add a literal prefix to every candidate", completion: ["$files", "$prefix(file://)"]}
  --retain=: {description: "$retain - keep only specific values from a list", completion: ["one", "two", "three", "$retain([two])"]}
  --shift=: {description: "$shift - look further back at already-typed args", completion: ["one", "two", "three", "$filterargs", "$shift(1)"]}
  --split=: {description: "$split - treat the typed word as comma-separated args", completion: ["one", "two", "three", "$filterargs", "$split"]}
  --splitp=: {description: "$splitp - like $split but only the last part", completion: ["one", "two", "three", "$filterargs", "$splitp"]}
  --style=: {description: "$style - force a display color/style", completion: ["one", "two", "three", "$style(underlined)"]}
  --suffix=: {description: "$suffix - add a literal suffix to every candidate", completion: ["apple", "melon", "orange", "$suffix(juice)"]}
  --suppress=: {description: "$suppress - hide an error message matching a pattern", completion: ["$message(fail)", "$suppress(fail)"]}
  --tag=: {description: "$tag - label a group of candidates", completion: ["one", "two", "three", "$tag(numbers)"]}
  --uniquelist=: {description: "$uniquelist - like $list but excludes already-used parts", completion: ["one", "two", "three", "$uniquelist(,)"]}
  --usage=: {description: "$usage - override the usage/placeholder message", completion: ["$usage(custom)"]}
SPEC
)
eval "$(compleo up <<<"$spec")"

for var in ${(ok)parameters[(I)compleo_*]}; do
  [[ -n ${(P)var} ]] && print -r -- "${var#compleo_} = ${(P)var}"
done
